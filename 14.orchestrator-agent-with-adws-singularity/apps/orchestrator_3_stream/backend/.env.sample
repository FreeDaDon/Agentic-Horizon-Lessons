# Database Configuration
DATABASE_URL=postgresql://user:password@host:5432/database

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Default working directory for agents
DEFAULT_WORKING_DIR=.

# Model Configuration (Optional)
# Override default model for orchestrator agent
# ORCHESTRATOR_MODEL=opus

# Override default model for command-level agents
# DEFAULT_AGENT_MODEL=opus

# Model for event summaries and autocomplete (default: haiku)
# FAST_MODEL=haiku

# Maximum PostgreSQL connections in the backend's pool (default: 20)
# DATABASE_POOL_SIZE=20
